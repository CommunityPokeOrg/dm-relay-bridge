# Discord bot token (Discord Developer Portal -> your app -> Bot -> Reset Token)
DISCORD_BOT_TOKEN=

# The ONLY Discord user whose DMs are relayed (numeric user ID)
DISCORD_ALLOWED_USER_ID=

# Telegram API credentials from https://my.telegram.org/apps
TG_API_ID=
TG_API_HASH=

# Path for the Telethon session file (created on first login; keep it private)
TG_SESSION=./tg_session

# Telegram chat to relay to: @username, phone number, numeric chat id, or 'me'
# ('me' = your own Saved Messages)
TG_TARGET=
